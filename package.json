{
  "name": "dreamdevops",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspaces --if-present",
    "start:api": "npm run start -w @dreamdevops/api",
    "start:dashboard": "npm run start -w @dreamdevops/dashboard",
    "test:e2e": "npm run test:e2e -w @dreamdevops/dashboard",
    "test:scaffolds": "npm run test:scaffolds -w @dreamdevops/api",
    "blueprints:publish": "npm run blueprints:publish -w @dreamdevops/api"
  }
}
