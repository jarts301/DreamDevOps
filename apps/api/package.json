{
  "name": "@dreamdevops/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @dreamdevops/shared-kernel",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build -w @dreamdevops/shared-kernel && tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:scaffolds": "vitest run --project scaffolds",
    "blueprints:publish": "node scripts/publish-blueprints.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node --env-file=../../infra/local/.env scripts/migrate.ts",
    "start": "npm run build && node --env-file=../../infra/local/.env scripts/start-local.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@casl/ability": "^7.1.1",
    "@dreamdevops/shared-kernel": "*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
