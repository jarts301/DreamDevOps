# Local development settings. Copy this file to .env, which Git ignores.
# These values are for your own machine only. Never reuse them on a server.
# Use letters and digits only in passwords, because the test scripts send them unescaped.

POSTGRES_SUPERUSER=platform
POSTGRES_SUPERUSER_PASSWORD=localdevpostgres
POSTGRES_PORT=5433

DREAMDEVOPS_DB_OWNER_PASSWORD=localdevowner
DREAMDEVOPS_DB_APP_PASSWORD=localdevapp
DREAMDEVOPS_DB_RELAY_PASSWORD=localdevrelay
DREAMDEVOPS_DB_JOBS_PASSWORD=localdevjobs

KEYCLOAK_DB_PASSWORD=localdevkeycloakdb
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=localdevkeycloak
KEYCLOAK_PORT=8081
DREAMDEVOPS_KEYCLOAK_CLIENT_SECRET=localdevclientsecret
# Password of the sample dev-* users in the dreamdevops realm.
KEYCLOAK_DEV_USER_PASSWORD=localdevuserpassword

FORGEJO_DB_PASSWORD=localdevforgejodb
FORGEJO_ADMIN_USERNAME=platform-admin
FORGEJO_ADMIN_PASSWORD=localdevforgejo
FORGEJO_ADMIN_EMAIL=platform-admin@example.com
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

API_PORT=4000
