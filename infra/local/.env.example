# Local development settings. Copy this file to .env, which Git ignores.
# Every password and secret here is a fake, public dummy value for your own machine.
# They protect nothing, so never use them, or anything like them, on a server.
# Use only letters, digits and hyphens, because the test scripts send them unescaped.

POSTGRES_SUPERUSER=platform
POSTGRES_SUPERUSER_PASSWORD=fake-dummy-postgres-superuser-password
POSTGRES_PORT=5433

DREAMDEVOPS_DB_OWNER_PASSWORD=fake-dummy-db-owner-password
DREAMDEVOPS_DB_APP_PASSWORD=fake-dummy-db-app-password
DREAMDEVOPS_DB_RELAY_PASSWORD=fake-dummy-db-relay-password
DREAMDEVOPS_DB_JOBS_PASSWORD=fake-dummy-db-jobs-password

KEYCLOAK_DB_PASSWORD=fake-dummy-keycloak-db-password
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=fake-dummy-keycloak-admin-password
KEYCLOAK_PORT=8081
DREAMDEVOPS_KEYCLOAK_CLIENT_SECRET=fake-dummy-keycloak-client-secret
# Password of the sample dev-* users in the dreamdevops realm.
KEYCLOAK_DEV_USER_PASSWORD=fake-dummy-sample-user-password

FORGEJO_DB_PASSWORD=fake-dummy-forgejo-db-password
FORGEJO_ADMIN_USERNAME=platform-admin
FORGEJO_ADMIN_PASSWORD=fake-dummy-forgejo-admin-password
FORGEJO_ADMIN_EMAIL=platform-admin@example.com
# The platform bot creates each company's organization.
FORGEJO_BOT_PASSWORD=fake-dummy-forgejo-bot-password
# Lets Forgejo sign people in through Keycloak.
FORGEJO_KEYCLOAK_CLIENT_SECRET=fake-dummy-forgejo-keycloak-secret
# Each repository's webhook secret is made from this, so the API can trust what Forgejo sends.
FORGEJO_WEBHOOK_SECRET=fake-dummy-forgejo-webhook-secret
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

API_PORT=4000

# Builds scan every image with Trivy, run through Docker. Set this to none to skip
# scanning, which is for local testing only and shows the step as skipped.
# IMAGE_SCANNER=trivy

# Deployments to "This machine" run applications as containers on this computer's
# Docker, with ports published on 127.0.0.1 only. Set LOCAL_HOSTING to off to turn
# this off, or the bind address to 0.0.0.0 to let other machines reach them.
# LOCAL_HOSTING=on
# LOCAL_HOSTING_BIND_ADDRESS=127.0.0.1

# The API sets up Dummy Company, with a sample account in each role, every time it
# starts locally. Set this to off to skip it.
# SAMPLE_DATA=on
# Dummy Company also gets a sample application for each type, language and framework,
# each with its repository and a Test environment. Set this to off to skip them.
# SAMPLE_APPLICATIONS=on

# Environments' secrets are sealed with a key the API creates in infra/local/secrets/ on
# first start. Keep it: secrets sealed with a lost key must be set again.
# SECRETS_KEY_FILE=

# Prometheus keeps the metrics applications send, which the dashboard shows under
# Monitoring. Its own page is at http://localhost:9090. Metrics older than the
# retention are deleted.
PROMETHEUS_PORT=9090
# METRICS_RETENTION=15d
# Where Prometheus's image comes from. Change it if your machine can't download it, such
# as behind a registry mirror. Docker Hub has the same image as prom/prometheus:v3.5.0.
# PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.5.0

# Jaeger keeps the traces applications send, which the dashboard shows under Monitoring.
# Its own page is at http://localhost:16686, and applications send traces to the OTLP port.
JAEGER_PORT=16686
JAEGER_OTLP_PORT=4318
# Where Jaeger's image comes from. Change it if your machine can't download it. Docker Hub
# has the same image as jaegertracing/jaeger:2.8.0.
# JAEGER_IMAGE=quay.io/jaegertracing/jaeger:2.8.0

# Mailpit catches every email locally. Read them at http://localhost:8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
